    "docs/CHANGELOG.md",
    "js/blas_cache.js",
    "js/blas_worker.js",
    "js/gi_clustered_lights_node.js",
    "js/gi_budget.js",
    "js/gi_irradiance_volume.js",
    "js/gi_lights_node.js",
