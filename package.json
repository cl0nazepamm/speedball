  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cl0nazepamm/speedball.git"
  },
  "homepage": "https://github.com/cl0nazepamm/speedball#readme",
  "bugs": {
    "url": "https://github.com/cl0nazepamm/speedball/issues"
  },
  "files": [
